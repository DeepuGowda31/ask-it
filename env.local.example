# Copy to .env.local and fill in. Never commit real values.

# --- Required -------------------------------------------------------------
# Agora Console -> your project -> App ID / App Certificate (certificate is server-side only)
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=
# Murf API key (Falcon TTS voice)
MURF_API_KEY=
# Shared secret Agora sends as the x-tool-secret header on every tool call (long random string)
TOOL_SECRET=

# --- Needed for live voice calls ------------------------------------------------
# Public https:// origin of this app. Agora's cloud calls /api/tools/* here, so localhost will not work.
PUBLIC_BASE_URL=

# --- Shared state (required on Vercel / any multi-instance deploy) ------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- ServiceNow tickets (all four for live; empty = simulated) ---------------------
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USER=askit.integration
SERVICENOW_PASSWORD=
SERVICENOW_CALLER_EMAIL=employee@example.com
# Optional: resolution code for incidents ASK IT resolves (default uses an en dash)
SERVICENOW_CLOSE_CODE=Resolved – Permanent Fix Applied
# IT desk reads incidents opened in the last N days (0 = all)
SERVICENOW_QUEUE_DAYS=30
# Optional, live mode: real master incident for the seeded SAP Concur outage
SERVICENOW_OUTAGE_INCIDENT=

# --- Auth0 identity (all six for live; empty = simulated) ---------------------------
# Machine-to-machine app with Management API access
AUTH0_DOMAIN=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Regular web app with the Passwordless OTP grant (email codes)
AUTH0_OTP_CLIENT_ID=
AUTH0_OTP_CLIENT_SECRET=
# The demo employee's email in Auth0
AUTH0_USER_EMAIL=employee@example.com

# --- IT channel (Slack bot cards win; else webhook; else simulated) -------------------
# Slack bot with chat:write, invited to the channel: one live status card per issue
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0000000000
# Webhooks: one message per milestone (Discord wins if both are set)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Optional ----------------------------------------------------------------
# Murf Falcon voice and locale (defaults: Aarav, en-IN)
MURF_VOICE_ID=
MURF_LOCALE=
# Bring-your-own OpenAI-compatible LLM instead of the Agora-managed gpt-4o-mini (both must be set)
NEXT_LLM_URL=
NEXT_LLM_API_KEY=
NEXT_LLM_MODEL=
# ms of speech needed to interrupt the speaking agent
AGENT_INTERRUPT_MS=
# Comma-separated words; when set, only these words interrupt the agent (e.g. stop,wait)
AGENT_INTERRUPT_KEYWORDS=
# true = Agora Selective Attention Locking (beta)
AGENT_SPEAKER_LOCK=
# on = say a short filler phrase while a tool runs (off by default)
AGENT_FILLER_WORDS=
